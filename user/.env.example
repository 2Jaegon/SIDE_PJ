# 개발자 설정은 이 파일 하나다. user/.env 로 복사해 값을 채운다.
# 백엔드(user/backend)와 프론트(user/frontend, VITE_로 시작하는 값만) 둘 다 이 파일을 읽는다.

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI 연결 (Antigravity CLI `agy` 사용, 키 불필요)
# GON_LLM=stub        # AI를 끄고 시험용 결과만 보기
# GON_LLM_WORKERS=3   # 동시 호출 수
# AGY_PATH=                   # agy 실행 파일 위치를 직접 지정

# Supabase 데이터베이스 연결 (PostgreSQL)
# [YOUR-PASSWORD]를 Supabase의 실제 데이터베이스 비밀번호로 교체
DATABASE_URL=postgresql://postgres.wdnyhnfooqmqlgtrdshn:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://wdnyhnfooqmqlgtrdshn.supabase.co
SUPABASE_PROJECT_REF=wdnyhnfooqmqlgtrdshn
JWT_SECRET=your-secret-key-here

# Google OAuth 2.0 (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=

# 프론트엔드 (Vite는 VITE_로 시작하는 값만 화면 코드에 넘긴다)
VITE_GOOGLE_CLIENT_ID=
